-- The same project, but with clash-prelude from Hackage instead of the pinned
-- commit in cabal.project. The supported range (>= 1.9 && < 1.12) includes
-- released versions, and most users take clash-prelude from Hackage, so CI
-- builds this variant too (see .github/workflows/ci.yml).
--
-- Usage: ./check.sh --project-file=cabal.project.hackage --builddir=dist-hackage
