        <mxCell id="a0" value="component" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;dashed=1;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="c0" target="vc0"><mxGeometry relative="1" as="geometry"/></mxCell>
