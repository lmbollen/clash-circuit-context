        <mxCell id="vtop" value="top" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="vout" value="out" style="text;html=1;fontSize=13;fontFamily=Courier New;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="75" width="120" height="25" as="geometry"/></mxCell>
        <mxCell id="vc0" value="counter_0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#666666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="vc0s" value="count&lt;br&gt;next" style="text;html=1;fontSize=13;fontFamily=Courier New;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="142" width="120" height="40" as="geometry"/></mxCell>
