        <mxCell id="top" value="&lt;b&gt;top&lt;/b&gt;&lt;br&gt;out = counter en + counter (not &amp;lt;$&amp;gt; en)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="340" height="215" as="geometry"/></mxCell>
