cabal-version: 2.4
name: clash-circuit-context
version: 0.1.0.0
synopsis: Scoped simulation tracing for Clash designs + GHC plugin
description:
  Scoped simulation tracing on unmodified clash-prelude (hierarchy,
  per-simulation trace maps, mealy probes, hierarchical VCD dumping) plus a
  GHC plugin that instruments designs automatically: OPAQUE toplevel
  functions with a HasCircuitContext constraint become components, and named
  local declarations are traced/probed under their binder names.

homepage: https://github.com/lmbollen/clash-circuit-context
bug-reports: https://github.com/lmbollen/clash-circuit-context/issues
license: BSD-2-Clause
license-file: LICENSE
author: QBayLogic
maintainer: Lucas Bollen <lucas@qbaylogic.com>
copyright: Copyright (c) 2026, QBayLogic B.V.
category: Hardware
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

tested-with: ghc ==9.10.3

source-repository head
  type: git
  location: https://github.com/lmbollen/clash-circuit-context.git

common common-options
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -haddock

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Clash.CircuitContext
    Clash.CircuitContext.Auto
    Clash.CircuitContext.Core
    Clash.CircuitContext.Plugin
    Clash.CircuitContext.Plugin.Names
    Clash.CircuitContext.Plugin.Oracle
    Clash.CircuitContext.Plugin.Rename
    Clash.CircuitContext.Shockwaves
    Clash.CircuitContext.Waveform
    Clash.CircuitContext.Waveform.Hedgehog

  -- On `clash-shockwaves`: supplies the ADT description (constructors, fields,
  -- bit ranges, styles) that this recorder's hierarchy does not model. Required
  -- of every traced payload, so tracing and typed waveforms arrive together;
  -- see Clash.CircuitContext.Shockwaves. It needs TypeAbstractions, hence the
  -- GHC >= 9.8 floor on this branch.
  --
  -- On `tagged`: circuit-notation desugars ports to Data.Tagged values, and
  -- the Traceable instance for Tagged lives in Auto.hs. Same range
  -- clash-prelude pins. (Kept out of the list itself: cabal-gild hoists
  -- interior comments to the top, where they read as being about `base`.)
  build-depends:
    aeson <2.3,
    base >=4.19 && <4.21,
    bytestring >=0.11 && <0.13,
    clash-prelude >=1.9 && <1.12,
    clash-shockwaves,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    ghc >=9.6 && <9.11,
    ghc-tcplugin-api ^>=0.19,
    hedgehog >=1.4 && <1.6,
    syb >=0.7 && <0.8,
    tagged >=0.8 && <0.9,
    text >=2.0 && <2.2,
    time >=1.12 && <1.15,

  ghc-options:
    -- Clash normalizes through the runtime combinators inside user designs,
    -- so every unfolding must be available — not just the ones GHC happens
    -- to expose. OPAQUE workers are exempt by definition, which is exactly
    -- right: their heap/instance identity must survive (see
    -- https://github.com/clash-lang/clash-compiler/pull/2511).
    -- Worker/wrapper would split functions Clash has to look through into
    -- unstable worker names; the OPAQUE pragmas protect the identity-bearing
    -- workers, this protects the rest.
    -fexpose-all-unfoldings
    -fno-worker-wrapper

-- Manual autoTrace calls (no renamer rewrite) against the real runtime;
-- validates the oracle's trace/fallback decisions per type.
-- A worked example of the API, kept honest by being built and run: it is what
-- the README's "Waveforms from your test suite" section points at.
executable example-waveforms
  import: common-options
  main-is: Waveforms.hs
  hs-source-dirs: examples
  build-depends:
    base,
    clash-circuit-context,
    clash-prelude,
    directory,
    hedgehog,

test-suite capture-smoke
  import: common-options
  type: exitcode-stdio-1.0
  main-is: CaptureSmoke.hs
  hs-source-dirs: tests
  build-depends:
    base,
    clash-circuit-context,
    clash-prelude,
    directory,
    filepath,
    hedgehog,

test-suite fallback
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Fallback.hs
  hs-source-dirs: tests
  build-depends:
    base,
    clash-circuit-context,
    clash-prelude,
    clash-shockwaves,
    containers,
    tagged,

  -- The plugin is required even for MANUAL autoTrace calls: its tc half
  -- reduces CanTrace/CanProbe. (The renamer half is a no-op here: the
  -- constrained functions have no local bindings.)
  ghc-options: -fplugin=Clash.CircuitContext.Plugin

-- The manually instrumented smoke design (golden-test basis).
test-suite manual-smoke
  import: common-options
  type: exitcode-stdio-1.0
  main-is: ManualSmoke.hs
  hs-source-dirs: tests
  build-depends:
    base,
    clash-circuit-context,
    clash-prelude,
    containers,
    text,

-- Golden test: the smoke design written naturally, instrumented entirely by
-- the plugin (component wrap, where->let, auto trace/probe).
test-suite auto-smoke
  import: common-options
  type: exitcode-stdio-1.0
  main-is: AutoSmoke.hs
  hs-source-dirs: tests
  build-depends:
    base,
    clash-circuit-context,
    clash-prelude,
    containers,
    text,

  ghc-options: -fplugin=Clash.CircuitContext.Plugin

-- Golden test against the REAL circuit-notation desugarer (not a hand-written
-- imitation of its output): `circuit` blocks desugared by the actual
-- parse-stage plugin, ports auto-traced by this plugin's renamer + the
-- Tagged/unit/tuple Traceable instances. Completing at all is the laziness
-- proof: the notation ties forward references through a lazy let knot, and a
-- strict trace would <<loop>>.
--
-- Only on dogfood/deps: it needs the trace-ports patch in the vendored
-- deps/circuit-notation, so it cannot build from a plain clone of main.
test-suite notation-smoke
  import: common-options
  type: exitcode-stdio-1.0
  main-is: NotationSmoke.hs
  other-modules: NotationSmokeTP
  hs-source-dirs: tests
  build-depends:
    base,
    circuit-notation,
    clash-circuit-context,
    clash-prelude,
    containers,
    text,

-- Both halves of the combined output from one simulation: this package's
-- hierarchy and the clash-shockwaves ADT sidecar, with no manual tracing calls.
test-suite shockwaves-smoke
  import: common-options
  type: exitcode-stdio-1.0
  main-is: ShockwavesSmoke.hs
  hs-source-dirs: tests
  build-depends:
    aeson,
    base,
    bytestring,
    clash-circuit-context,
    clash-prelude,
    clash-shockwaves,
    ghc-typelits-knownnat,
    ghc-typelits-natnormalise,
    text,

  -- BitPack on a sum type needs KnownNat (CLog 2 n); the typelits solvers are
  -- what every real Clash design uses for this.
  ghc-options:
    -fplugin=Clash.CircuitContext.Plugin
    -fplugin=GHC.TypeLits.KnownNat.Solver
    -fplugin=GHC.TypeLits.Normalise
