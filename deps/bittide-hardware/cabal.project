packages:
  bittide-cpus/
  bittide-experiments/
  bittide-extra/
  bittide-instances/
  bittide-shake/
  bittide/
  gdb-hs/
  ghc-typelits-extra-lemmas/
  vivado-hs/
  -- The tracing runtime + GHC plugin under test. Path-relative so this tree
  -- builds straight out of the clash-circuit-context checkout that vendors it.
  ../../clash-circuit-context.cabal
  -- Instrumented dependency checkouts, replacing the source-repository-package
  -- pins that are commented out below. Each is its pinned upstream commit plus
  -- the plugin enabled and HasCircuitContext added to its circuit combinators.
  ../clash-protocols/clash-protocols
  ../clash-protocols/clash-protocols-base
  ../clash-protocols-memmap/clash-protocols-memmap
  ../clash-protocols-memmap/clash-bitpackc
  ../clash-cores
  -- circuit-notation 0.3 + the trace-ports patch. Needed here (rather than the
  -- Hackage 0.2) because trace-ports is what makes a `circuit` block's INTERFACE
  -- ports visible to the tracing renamer, not just its intermediate <- ports.
  ../circuit-notation
  -- Typed waveforms. Required now that every traced signal carries its payload
  -- type's ADT description; memmap already depended on it (and ships the
  -- Wishbone Waveform instances), this just points at the vendored checkout.
  ../clash-shockwaves/clash-shockwaves

-- We depend on the clash-circuit-context *library* only; its own test-suites
-- pin a patched circuit-notation that is absent from this project.
package clash-circuit-context
  tests: False
  benchmarks: False

-- The instrumented dependencies are local packages now, so the project-wide
-- `tests: True` would pull in their doctest/unittest suites too. We only need
-- their libraries (bittide links them); their suites are noise here and would
-- recompile on every constraint tweak.
package clash-protocols
  tests: False

package clash-protocols-base
  tests: False

package clash-protocols-memmap
  tests: False

package clash-bitpackc
  tests: False

package clash-cores
  tests: False

write-ghc-environment-files: always
-- index state, to go along with the cabal.project.freeze file. update the index
-- state by running `cabal update` twice and looking at the index state it
-- displays to you (as the second update will be a no-op)
index-state: 2026-06-12T08:52:58Z
tests: True

package bittide
  -- Tweak haddock stylesheet to enable word wrapping of types.
  -- We specify the default Linuwial theme as an alternate
  -- so we're able to import its css file from the custom theme.
  haddock-options: --theme=linuwial-wrap-types.css --theme=Linuwial

package zlib
  flags: +pkg-config

package *
  ghc-options: +RTS -qn4 -K512M -H -I5 -T -RTS
semaphore: true
jobs: $ncpus

-- NOTE (dogfood/deps): the pins for clash-protocols, clash-protocols-memmap and
-- clash-cores are commented out and replaced by the local instrumented
-- checkouts listed under `packages` above. Kept here for provenance: each
-- checkout sits at exactly the commit named below, so its instrumentation is
-- readable as a diff against that commit. The dogfood/bittide branch has these
-- pins live and instruments nothing but bittide itself.
--
-- source-repository-package
--   type: git
--   location: https://github.com/QBayLogic/clash-protocols-memmap
--   tag: 20bacc70c1ef1802cfa02228bfddbc7e8cd86f03
--   subdir:
--     clash-protocols-memmap
--     clash-bitpackc
--
-- source-repository-package
--   type: git
--   location: https://github.com/clash-lang/clash-protocols.git
--   tag: e03dbd8917cb7c93911810824e54e4423a0ae08b
--   subdir:
--     clash-protocols
--     clash-protocols-base

-- TODO: Switch to Clash 1.10.1. It should have all the performance upgrades we want.
source-repository-package
  type: git
  location: https://github.com/clash-lang/clash-compiler.git
  tag: 3df8daf03f3fffc0a9873c3a85ca928e8d919354
  subdir:
    clash-prelude
    clash-ghc
    clash-lib
    clash-prelude-hedgehog
    clash-lib-hedgehog

-- TODO: Switch to released package once it is on Hackage
-- Replaced by ../clash-cores (instrumented), which sits at this commit:
--
-- source-repository-package
--   type: git
--   location: https://github.com/clash-lang/clash-cores.git
--   tag: 5d084eff6cdc630ecd14be53bdc4fa30a5a4fd95

-- Allow us to load multiple packages into a REPL session at once. For example:
--
--   cabal repl bittide bittide:unittests
--
-- Can also be used in combination with ghcid:
--
--   ghcid -c cabal repl bittide bittide:unittests
--
-- Note that it is not limited to units from the same Cabal file:
--
--   cabal repl bittide bittide:unittests bittide-instances bittide-instance:unittests
--
-- Finally, we maintain a script that loads _all_ development packages:
--
--   repld
--
-- This is also usable in combination with ghcid:
--
--   ghcid -c repld
multi-repl: True
